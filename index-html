<!DOCTYPE html>
<html>
<head>
    <title>Betway Loader MF2</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { 
            font-family: Arial; 
            background: #1a1a1a; 
            color: white; 
            text-align: center; 
            padding: 20px;
        }
        input { 
            padding: 15px; 
            width: 80%; 
            font-size: 18px; 
            border-radius: 8px;
            border: none;
            margin: 20px 0;
        }
        button { 
            padding: 15px 30px; 
            font-size: 18px; 
            background: #00A859; 
            color: white; 
            border: none; 
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <h2>Betway Code Loader 👑</h2>
    <p>Paste code from Twitter:</p>
    <input type="text" id="codeInput" placeholder="Paste code here">
    <br>
    <button onclick="loadBetslip()">Open in Betway</button>

    <script>
        function loadBetslip() {
            const code = document.getElementById('codeInput').value.trim();
            if(!code) return alert('Enter a code mf2');
            // FIXED Betway format 2026
            window.location.href = "https://www.betway.co.za/sports/betslip?betslipid=" + code;
        }
    </script>
</body>
</html>
